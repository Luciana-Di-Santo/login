# Entorno de ejecucion: development | test | production
NODE_ENV=development
PORT=3000

# Configuracion de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=inventario_app
DB_PASSWORD=
DB_NAME=inventario_db

# Umbral global de stock bajo (productos con 0 < stock <= LOW_STOCK_THRESHOLD)
LOW_STOCK_THRESHOLD=5

